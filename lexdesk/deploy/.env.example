# LexDesk production settings. Copy to .env and fill in.
# Then add the secret keys:   python3 generate_keys.py >> .env
# Never commit .env. Keep an offline copy: the keys cannot be recovered.

# ---- The platform ----------------------------------------------------------
LEXDESK_DEBUG=0
# Your domain. Firms get <name>.<domain>, e.g. nsc.lexdesk.co.ug
LEXDESK_BASE_DOMAIN=lexdesk.co.ug
LEXDESK_WEB_URL=https://lexdesk.co.ug
# The API is reached only through the web app and Caddy on this server.
LEXDESK_ALLOWED_HOSTS=api,localhost,lexdesk.co.ug,www.lexdesk.co.ug,.lexdesk.co.ug
LEXDESK_CORS_ORIGINS=https://lexdesk.co.ug
LEXDESK_TRUST_X_FORWARDED_FOR=1
# Caddy terminates https and redirects; the API sits behind it.
LEXDESK_SSL_REDIRECT=0
LEXDESK_ADMIN_EMAIL=you@yourcompany.co.ug
LEXDESK_FIRM_NAME=LexDesk
LEXDESK_TIME_ZONE=Africa/Kampala
LEXDESK_DEFAULT_COUNTRY_CODE=256
LEXDESK_CURRENCY=UGX
# Let firms register themselves from the website (1) or by invitation only (0).
LEXDESK_ALLOW_FIRM_SIGNUP=1
LEXDESK_REQUIRE_MFA_FOR_STAFF=1
GUNICORN_WORKERS=3

# ---- Database --------------------------------------------------------------
POSTGRES_DB=lexdesk
POSTGRES_USER=lexdesk
# POSTGRES_PASSWORD is added by generate_keys.py

# ---- Email (required: activation links and reminders) ----------------------
# Any SMTP provider: Google Workspace, Microsoft 365, Zoho, Brevo, Mailgun...
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LexDesk <no-reply@lexdesk.co.ug>
LEXDESK_EMAIL_DOMAIN=lexdesk.co.ug

# ---- Platform-wide defaults (each firm can use its own in Firm settings) ---
# WhatsApp: off | console | meta. Firms with their own WhatsApp Business
# number connect it themselves in Settings > Firm settings > WhatsApp.
LEXDESK_WHATSAPP_BACKEND=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
LEXDESK_WHATSAPP_TEMPLATE=lexdesk_notice
LEXDESK_WHATSAPP_TEMPLATE_LANGUAGE=en
LEXDESK_WHATSAPP_STAFF_OPTED_IN=1

# SMS: console | africastalking (firms can also use their own account)
LEXDESK_SMS_BACKEND=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ---- Optional: documents in S3-compatible storage instead of the server disk
# LEXDESK_S3_BUCKET=
# LEXDESK_S3_REGION=
# LEXDESK_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

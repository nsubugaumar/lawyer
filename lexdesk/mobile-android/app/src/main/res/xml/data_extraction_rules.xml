<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing from LexDesk goes into cloud backups or device-to-device
  transfers. The app holds a signed-in session and court briefs saved for
  offline use; they must stay on this phone only and vanish with the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

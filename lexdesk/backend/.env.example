# LexDesk notifications: production settings.
# Copy into your secrets manager / server environment. Never commit real values.

# --- Workers (required for reminders) ---------------------------------------
# Run all three. Beat is what fires reminders on time, every minute.
#   celery -A config worker -l info
#   celery -A config beat -l info
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# --- Email -------------------------------------------------------------------
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Your Firm <diary@yourfirm.co.ug>"
LEXDESK_EMAIL_DOMAIN=yourfirm.co.ug

# --- WhatsApp (Meta WhatsApp Business Cloud API) -----------------------------
# 1. business.facebook.com -> WhatsApp Manager: add and verify the firm's number.
# 2. Create a Utility template named lexdesk_notice, language English, body:
#        {{1}}
#
#        {{2}}
#
#        {{3}}
#    Optional URL button "Open LexDesk" -> https://app.yourfirm.co.ug/{{1}}
#    (then set LEXDESK_WHATSAPP_TEMPLATE_HAS_BUTTON=1).
# 3. Create a System User with a permanent token (whatsapp_business_messaging).
# 4. Webhook URL: https://api.yourfirm.co.ug/api/v1/notifications/whatsapp/webhook/
#    Verify token: the value of WHATSAPP_WEBHOOK_VERIFY_TOKEN below.
#    Subscribe to the "messages" field (delivery ticks and STOP replies).
LEXDESK_WHATSAPP_BACKEND=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
LEXDESK_WHATSAPP_TEMPLATE=lexdesk_notice
LEXDESK_WHATSAPP_TEMPLATE_LANGUAGE=en
LEXDESK_WHATSAPP_TEMPLATE_HAS_BUTTON=0
# Staff consent is recorded once in their employment contract. Set to 0 to
# make every member of staff switch WhatsApp on themselves.
LEXDESK_WHATSAPP_STAFF_OPTED_IN=1

# --- SMS fallback (Africa's Talking) -----------------------------------------
# pip install africastalking
LEXDESK_SMS_BACKEND=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Local conventions -------------------------------------------------------
LEXDESK_TIME_ZONE=Africa/Kampala
LEXDESK_DEFAULT_COUNTRY_CODE=256
LEXDESK_AGENDA_ON_WEEKENDS=0
